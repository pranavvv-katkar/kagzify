# Kagzify Studio Environment Variables Example

# Database URL
DATABASE_URL="file:./dev.db"
# Or PostgreSQL:
# DATABASE_URL="postgresql://username:password@localhost:5432/kagzify_db?schema=public"

# Authentication secret
JWT_SECRET="your-strong-random-secret-key-here"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Admin Seeding Credentials
ADMIN_INITIAL_EMAIL="admin@kagzify.com"
ADMIN_INITIAL_PASSWORD="AdminPassword123!"

# Upload directory
UPLOAD_DIR="public/uploads"
